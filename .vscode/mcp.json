{
  // Instructions MCP Server - Manages centralized instruction files for GitHub Copilot
  // IMPORTANT: After switching profiles with set_active_profile, start a NEW CHAT
  // to use the new instructions effectively, or manually tell Copilot to ignore previous context
  "servers": {
    "instructions-mcp": {
      "command": "uv",
      "args": [
        "run", 
        "python", 
        "main.py"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "GITHUB_TOKEN": "${input:githubToken}",
        "CONTEXT_CONFIG_FILE": "${input:configFile}",
        "INSTRUCTIONS_DIR": "${input:instructionsDir}"
      }
    }
  },
  "inputs": [
    {
      "id": "githubToken",
      "description": "GitHub Personal Access Token (for API access)",
      "type": "promptString",
      "password": true
    },
    {
      "id": "configFile",
      "description": "Context configuration file path or URL. After switching profiles, start a NEW CHAT for instructions to take effect.",
      "type": "promptString",
      "default": "https://gist.github.com/coley-angel/98bd62f772fdcbf95d84dfb1306a2263/raw/e52cdd5c07dfde21c39e23bbb3877a6c032478bf/gistfile1.yaml"
    },
    {
      "id": "instructionsDir",
      "description": "Base directory for storing instruction files. Profile changes require NEW CHAT or manual context clearing.",
      "type": "promptString",
      "default": "~/vscode-instructions"
    }
  ]
}
